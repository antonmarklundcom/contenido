# Sin listado de directorios
Options -Indexes

# Nunca servir logs, entornos, configs, dumps, backups ni dotfiles
<FilesMatch "(\.(log|env|ini|sql|bak)$|^leads|^\.)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
